# Normalize line endings in the repository (checkouts use the platform's native endings).
* text=auto

# Binary media
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.mp4 binary
*.wav binary
*.mp3 binary
*.flac binary
*.bmp binary

# The remaster's generated robot and arena files (the original game's binary formats)
*.AF binary
*.BK binary
*.WID binary

# The original game's files and the HD artwork (see NOTICE.md) are binary; their JSON indexes are text.
public/gamedata/** binary
public/hd/** binary
public/gamedata/*.json text
public/hd/*.json text
public/hd/menu/*.json text
